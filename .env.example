# Root-level env file, read automatically by `docker-compose` for variable
# substitution in docker-compose.yml. Copy to `.env` (already gitignored) and
# fill in real values before running `docker-compose up`.
#
# This is separate from backend/.env and frontend/.env* — those configure the
# app itself; this one only configures the local Docker Mongo container.

# Credentials for the docker-compose MongoDB service. Required — without
# these, docker-compose refuses to start rather than silently running Mongo
# with no authentication (see docker-compose.yml).
MONGO_ROOT_USERNAME=driveclique_admin
MONGO_ROOT_PASSWORD=change-me-to-a-strong-random-value
