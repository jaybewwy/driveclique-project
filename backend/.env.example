# Server Configuration
PORT=5000
NODE_ENV=development

# Database
MONGO_URI=mongodb://localhost:27017/driveclique

# JWT Secret (generate a strong random string for production)
JWT_SECRET=your-super-secret-jwt-key-here

# Frontend URL (used to build password reset links in emails)
FRONTEND_URL=http://localhost:5173

# ── Email address validation ──────────────────────────────────────────────────
# https://github.com/umuterturk/email-verifier
# Runs before registration: checks syntax, domain, MX records, blocks disposables.
# Defaults to the free public instance. Set to your own host if self-hosting via Docker.
EMAIL_VERIFIER_URL=https://rapid-email-verifier.fly.dev

# ── Admin analytics dashboard ─────────────────────────────────────────────────
# Comma-separated list of emails allowed to access GET /api/events/admin-summary
# and the /admin/analytics frontend page. Unset/empty = route always returns 403.
# ADMIN_EMAILS=you@example.com

# ── Production CORS ───────────────────────────────────────────────────────────
# Deployed web frontend origin (e.g. Railway / Vercel URL).
# Capacitor origins (capacitor://localhost, http://localhost) are always allowed.
# ALLOWED_ORIGIN_WEB=https://app.driveclique.com

# ── SMTP email (optional) ─────────────────────────────────────────────────────
# Emails are silently skipped when not configured (safe for local development).
# SMTP_HOST=smtp.sendgrid.net
# SMTP_PORT=587
# SMTP_USER=apikey
# SMTP_PASS=your-sendgrid-api-key
# EMAIL_FROM=DriveClique <noreply@driveclique.com>