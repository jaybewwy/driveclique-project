# Server Configuration
PORT=5000
NODE_ENV=development

# Database
MONGO_URI=mongodb://localhost:27017/driveclique

# JWT Secret (generate a strong random string for production)
JWT_SECRET=driveclique-jwt-secret-key-2024

# Frontend URL (used to build password reset links in emails)
FRONTEND_URL=http://localhost:5173

# Email address verifier (https://github.com/umuterturk/email-verifier)
# Validates syntax, domain, MX records, and blocks disposable addresses at registration.
# Defaults to the public hosted instance — set to your own if self-hosting.
EMAIL_VERIFIER_URL=https://rapid-email-verifier.fly.dev

# Postmark (primary email provider — https://postmarkapp.com)
# Get your Server API Token from Postmark → Server → API Tokens
# POSTMARK_FROM must be a verified sender address or domain in your Postmark account
POSTMARK_SERVER_TOKEN=your-postmark-server-token
POSTMARK_FROM=DriveClique <noreply@yourdomain.com>