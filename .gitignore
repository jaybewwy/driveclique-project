# Dependencies
node_modules/
backend/node_modules/

# Environment variables
.env
*.env.local
*.env.production

# Build outputs
dist/
build/

# Logs
logs/
*.log
npm-debug.log*

# OS files
.DS_Store
Thumbs.db

# IDE
.vscode/
.idea/
*.swp
*.swo

# Coverage
coverage/

# Cache
.cache/
.parcel-cache/

# Playwright
playwright-report/
playwright-trace/
test-results/


# Misc
# (*.md below also intentionally keeps the memory-bank working docs —
#  .claude/rules/activeContext.md and .claude/rules/progress.md — out of
#  GitHub; they're fast-moving local session notes, not repo documentation.
#  Untracked via `git rm --cached` once; this rule keeps them untracked.)
*.md
*.bak
*.tmp
APA7_DriveClique_Paper_Draft.txt
backend/test-api.js

# ── Images & binary assets ────────────────────────────────────────────────────
*.png
*.jpg
*.jpeg
*.gif
*.webp
*.ico
*.bmp
*.tiff
# SVG files are vector source art and are intentionally tracked
# Playwright documentation screenshots (e.g. tests/e2e/screenshots/map-*.png)
# stay ignored here too — they're regenerated per-session, not repo assets.

# Real brand assets (logo mark, app icons, splash) ARE tracked despite the
# blanket *.png rule above — without them the app ships with no logo at all.
!frontend/public/logo-mark.png
!frontend/public/favicon.png
!frontend/public/favicon-32.png
!frontend/src/assets/logo-mark.png
!frontend/src/assets/brand-source/
!frontend/src/assets/brand-source/*.jpg
!frontend/public/icons/
!frontend/public/icons/*.png
!mobile/assets/
!mobile/assets/*.png
!mobile/src/assets/
!mobile/src/assets/logo-mark.png

# ── XML config / resource files ───────────────────────────────────────────────
*.xml

# ── Generated mobile icons (re-included above — see brand assets note) ────────

# ── Capacitor native projects (auto-generated, not needed in git) ─────────────
# To restore:  cd frontend && npx cap add android && npx cap add ios && npx cap sync
frontend/android/
frontend/ios/

# ── Frontend env files (contain API URLs / secrets) ──────────────────────────
frontend/.env
frontend/.env.capacitor
frontend/.env.production
frontend/.env.local
*.ts
!frontend/tests/e2e/*.spec.ts
*.md
