# Logs
logs
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
lerna-debug.log*

# Dependencies
node_modules

# Build output
dist
dist-ssr

# Editor directories and files
.vscode/*
!.vscode/extensions.json
.idea
.DS_Store
*.suo
*.ntvs*
*.njsproj
*.sln
*.sw?

# ── Environment files (contain API URLs / secrets) ───────────────────────────
.env
.env.*

# ── Images & binary assets ───────────────────────────────────────────────────
*.png
*.jpg
*.jpeg
*.gif
*.webp
*.ico
*.bmp
*.tiff
# SVG files are vector source art and are intentionally tracked
# Playwright documentation screenshots (e.g. tests/e2e/screenshots/map-*.png)
# stay ignored here too — they're regenerated per-session, not repo assets.

# Real brand assets (logo mark, app icons, splash) ARE tracked despite the
# blanket *.png rule above — without them the app ships with no logo at all.
!public/logo-mark.png
!public/favicon.png
!public/favicon-32.png
!src/assets/logo-mark.png
!src/assets/brand-source/
!src/assets/brand-source/*.jpg
!public/icons/
!public/icons/*.png

# Playwright fixture image (avatar-propagation-screenshots.spec.ts uploads this
# file) — needs to be a tracked repo asset, not regenerated per-run.
!tests/e2e/fixtures-avatar-test.png

# ── XML config / resource files ─────────────────────────────────────────────
*.xml

# ── Capacitor native projects (auto-generated) ───────────────────────────────
# To restore:  npx cap add android && npx cap add ios && npx cap sync
android/
ios/
